{
    "include": [
        "server/**/*"
    ],
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "es6",
        "sourceMap": true,
        "outDir": "build",
        "allowJs": true,
        "checkJs": true,
        "lib": [
            "es2017"
        ],
        "types": [
            "node",
            "jasmine"
        ]
    },
    "exclude": [
        "node_modules"
    ]
}